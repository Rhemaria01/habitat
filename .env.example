PORT=3001

# PostgreSQL connection string (Prisma uses DATABASE_URL via @prisma/adapter-pg)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"
# Optional: direct (non-transaction-pooler) URL for Prisma Migrate
# DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

ACCESS_KEY=your-private-login-passphrase
SESSION_SECRET=replace-with-openssl-rand-hex-32

# Optional: daily DB keep-alive (Vercel cron → GET /api/cron/keep-alive). Default off.
# Useful on hosts that pause idle databases (e.g. Supabase free tier).
# DATABASE_KEEP_ALIVE_ENABLED=true
# CRON_SECRET=replace-with-openssl-rand-hex-32
# CRON_TIME=0 3 * * *
