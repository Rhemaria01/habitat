// Prisma schema for Habitat (PostgreSQL).
// Schema changes: edit this file, then `npm run db:migrate` (dev) or deploy with `npm run db:deploy`.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum habit_kind {
  build
  quit

  @@map("habit_kind")
}

enum habit_behavior_type {
  build
  reduce
  avoid

  @@map("habit_behavior_type")
}

model Profile {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  timezone       String   @default("Asia/Kolkata")
  week_start     Int      @default(1) @db.SmallInt
  identity_note  String?
  onboarding     Json     @default("{}")
  created_at     DateTime @default(now()) @db.Timestamptz(6)
  updated_at     DateTime @default(now()) @db.Timestamptz(6)

  @@map("profiles")
}

model Habit {
  id                         String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                       String
  kind                       habit_kind
  behavior_type              habit_behavior_type @default(build)
  description                String?
  category                   String?
  personal_reason            String?
  start_date                 DateTime            @db.Date
  color                      String              @default("#7C9A82")
  icon                       String?
  sort_order                 Int                 @default(0)
  archived_at                DateTime?           @db.Timestamptz(6)
  status                     String              @default("active")
  created_at                 DateTime            @default(now()) @db.Timestamptz(6)
  updated_at                 DateTime            @default(now()) @db.Timestamptz(6)
  frequency                  String              @default("daily")
  stack_after                String?
  two_minute_version         String?
  minimum_version            String?
  standard_version           String?
  stretch_version            String?
  estimated_duration_minutes Int?
  identity_proof             String?
  source_key                 String?
  cue_type                   String?
  cue_time                   String?
  cue_place                  String?
  cue_event                  String?
  anchor_habit_id            String?             @db.Uuid
  cue_notes                  String?
  motivation_meaning         String?
  motivation_appeal          String?
  motivation_pairing         String?
  motivation_social          String?
  friction_obstacle          String?
  friction_environment       String?
  friction_increase          String?
  commitment_mechanism       String?
  reward_feedback            String?
  reward_personal            String?
  recovery_plan              String?
  recovery_reminder          Boolean             @default(true)
  schedule_kind              String              @default("daily")
  schedule_weekdays          Int[]               @default([])
  schedule_days_per_week     Int?                @db.SmallInt
  schedule_custom_days       Int[]               @default([])
  schedule_interval_days     Int?                @db.SmallInt
  schedule_end_date          DateTime?           @db.Date
  time_window                String?
  planned_time               String?
  tracking_target            Int?
  tracking_type              String              @default("binary")
  tracking_unit              String?
  is_priority                Boolean             @default(false)
  card_art_key               String?
  card_cover_style           String?
  logs                       HabitLog[]
  anchor_habit               Habit?              @relation("HabitAnchor", fields: [anchor_habit_id], references: [id], onDelete: SetNull)
  anchored_by                Habit[]             @relation("HabitAnchor")

  @@map("habits")
}

model HabitLog {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  habit_id         String    @db.Uuid
  log_date         DateTime  @db.Date
  status           String
  note             String?
  numeric_value    Decimal?  @db.Decimal
  completion_level String?
  created_at       DateTime  @default(now()) @db.Timestamptz(6)
  updated_at       DateTime  @default(now()) @db.Timestamptz(6)
  habit            Habit     @relation(fields: [habit_id], references: [id], onDelete: Cascade)

  @@unique([habit_id, log_date])
  @@index([habit_id, log_date], map: "habit_logs_habit_date_idx")
  @@map("habit_logs")
}
